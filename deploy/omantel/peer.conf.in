[$endpoint]
type=endpoint
transport=omantel-udp
context=from-omantel
aors=$aor
identify_by=ip
deny=0.0.0.0/0
permit=$sbc/32
disallow=all
allow=alaw:20
use_ptime=no
dtmf_mode=inband
direct_media=no
media_address=100.127.29.138
bind_rtp_to_media_address=yes
rtp_symmetric=no
force_rport=yes
rewrite_contact=no
ice_support=no
media_encryption=no
rtp_timeout=60
rtp_timeout_hold=300
send_pai=yes
send_rpid=no
from_user=$caller_id
callerid=$caller_id
trust_id_inbound=no
trust_id_outbound=no
send_connected_line=no
allow_transfer=no
allow_subscribe=no

[$aor]
type=aor
contact=sip:$sbc:5060
max_contacts=0
qualify_frequency=30
qualify_timeout=3.0
qualify_2xx_only=yes

[$identify]
type=identify
endpoint=$endpoint
match=$sbc/32
