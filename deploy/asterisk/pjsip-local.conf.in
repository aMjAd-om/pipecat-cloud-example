[transport-udp]
type=transport
protocol=udp
bind=$lan_ip:5060

[1001]
type=endpoint
transport=transport-udp
context=from-linphone
disallow=all
allow=alaw,ulaw
auth=auth1001
aors=1001
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[auth1001]
type=auth
auth_type=userpass
username=1001
password=$sip_password

[1001]
type=aor
max_contacts=1
remove_existing=yes
