# Review and merge into the intended site's config; this file is not installed automatically.
server {
    listen 443 ssl;
    server_name voice.example.com;
    ssl_certificate /etc/letsencrypt/live/voice.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voice.example.com/privkey.pem;

    # Protect the experimental agent before exposing billable Azure services.
    auth_basic "Voice lab";
    auth_basic_user_file /etc/nginx/voice-lab.htpasswd;
    client_max_body_size 128k;

    location / {
        proxy_pass http://127.0.0.1:7860;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
}
