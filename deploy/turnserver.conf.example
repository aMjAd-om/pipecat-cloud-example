# Install/review separately on a host with a reachable public address.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_BACKEND_TURN_SECRET
realm=voice.example.com
server-name=voice.example.com
min-port=49160
max-port=49200
no-cli
no-multicast-peers
no-tcp-relay
user-quota=8
total-quota=64
cert=/etc/letsencrypt/live/voice.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/voice.example.com/privkey.pem
# If coturn is behind 1:1 NAT, replace these placeholders and uncomment:
# listening-ip=PRIVATE_IP
# relay-ip=PRIVATE_IP
# external-ip=PUBLIC_IP/PRIVATE_IP
