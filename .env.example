# Azure Speech (STT and TTS)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=uaenorth
AZURE_STT_LANGUAGE=ar-OM
AZURE_TTS_VOICE_AR=ar-SA-HamedNeural
AZURE_TTS_VOICE_EN=en-US-JennyNeural

# Speech output provider: azure (default), cartesia or munsit. Azure STT is unchanged.
TTS_PROVIDER=azure
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=47c38ca4-5f35-497b-b1a3-415245fb35e1
CARTESIA_SPEED=1.3
CARTESIA_VOLUME=1

# Munsit Faseeh v1 preview (Arabic streaming PCM)
MUNSIT_API_KEY=your_munsit_api_key
MUNSIT_VOICE_ID=SyU41Fvh3zAI9ZRf81uuTYQ4
MUNSIT_SPEED=1.0
MUNSIT_STABILITY=0.5

# Azure Foundry GPT-4.1-mini (separate credentials from Speech)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_BASE_URL=https://ai-lab-datamining-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini


# Application
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ar
# Fixed conversation language; customer speech never changes it.
# Set false to compare with the legacy assistant.
SURVEY_CONVERSATION_MANAGER=true
SURVEY_QUESTIONNAIRE=questionnaires/customer-satisfaction.ar.json
# Optional registered agent; blank preserves the questionnaire configuration above.
AGENT_ID=
# Enable synthetic customers only for the separately launched text lab.
DEMO_TESTING_ENABLED=false
# Optional telephone agent override and operator-owned per-channel selection JSON.
TELEPHONY_AGENT_ID=
# TELEPHONY_CALL_CONFIG=/app/call-config.json

# Operator web page (exact origins, no trailing slash)
HOST=127.0.0.1
PORT=7860
FRONTEND_ORIGINS=http://localhost:7860,http://127.0.0.1:7860

# Operator login protects the page, call controls and live transcripts.
# Generate a private random password of at least 16 characters. No default password.
DIALER_USERNAME=operator
DIALER_PASSWORD=
# Enable only after installing deploy/asterisk/extensions-web.conf and manager.conf.
OUTBOUND_ENABLED=false
# Optional comma-separated eight-digit destinations for the initial test.
# Blank permits any validated eight-digit Oman destination except our own DID block.
OUTBOUND_ALLOWED_NUMBERS=
ASTERISK_AMI_USERNAME=web-dialer
ASTERISK_AMI_SECRET=
ASTERISK_AMI_PORT=5038

# Optional Asterisk media socket; loopback only, Ubuntu host networking required.
TELEPHONY_ENABLED=false
TELEPHONY_PORT=7861
TELEPHONY_MAX_CALLS=2
TELEPHONY_MAX_SECONDS=900
# Temporary per-call PCM counters/levels every 5s; no audio/transcripts logged.
TELEPHONY_AUDIO_DIAGNOSTICS=false

# Optional standalone text lab: run python -m voice_agent.api.survey_chat (never auto-started).
SURVEY_CHAT_PORT=7862
