# Azure Speech (STT and TTS)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=uaenorth
AZURE_STT_LANGUAGE=ar-OM
AZURE_TTS_VOICE_AR=ar-SA-HamedNeural
AZURE_TTS_VOICE_EN=en-US-JennyNeural

# Speech output provider: azure (default) or cartesia. Azure STT is unchanged.
TTS_PROVIDER=azure
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=47c38ca4-5f35-497b-b1a3-415245fb35e1
CARTESIA_SPEED=1.3
CARTESIA_VOLUME=1

# Azure Foundry GPT-4.1-mini (separate credentials from Speech)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_BASE_URL=https://ai-lab-datamining-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini


# Application
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ar
# Fixed conversation language; customer speech never changes it.
# Set false to compare with the legacy assistant.
SURVEY_CONVERSATION_MANAGER=true
SURVEY_QUESTIONNAIRE=questionnaire.customer-satisfaction.ar.json

# Self-hosted signaling / browser origins (exact origins, no trailing slash)
HOST=127.0.0.1
PORT=7860
FRONTEND_ORIGINS=http://localhost:7860,http://127.0.0.1:7860
MAX_SESSIONS=4
SESSION_MAX_SECONDS=900

# Optional Asterisk media socket; loopback only, Ubuntu host networking required.
TELEPHONY_ENABLED=false
TELEPHONY_PORT=7861
TELEPHONY_MAX_CALLS=2
TELEPHONY_MAX_SECONDS=900
# Temporary per-call PCM counters/levels every 5s; no audio/transcripts logged.
TELEPHONY_AUDIO_DIAGNOSTICS=false

# Optional standalone text lab: run python survey_chat.py (never auto-started).
SURVEY_CHAT_PORT=7862

# No public ICE service is used by default. Localhost/LAN: []
ICE_SERVERS=[]
# Optional self-hosted coturn; these are short-lived browser relay credentials.
# TURN_URLS=turn:voice.example.com:3478?transport=udp,turns:voice.example.com:5349?transport=tcp
# TURN_SECRET=replace_with_a_long_random_shared_secret
